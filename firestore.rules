rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Single fixed admin UID (Markus's Google account) — the whole
    // database, nothing else needed given this app has exactly one user
    // (spec.md §1a/§1b.1).
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'Dc17PeVAuMbtH0AcrDbqH2ayZgI3';
    }
  }
}
